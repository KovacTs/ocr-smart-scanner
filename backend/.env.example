# =====================================================================
# Smart OCR Scanner Backend - .env.example
# =====================================================================
PROJECT_NAME="Smart OCR Scanner API"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY=super-secret-ocr-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite:///./ocr_scanner.db
# Para PostgreSQL:
# DATABASE_URL=postgresql://ocr_user:ocr_secure_password_2026@localhost:5432/ocr_scanner

# Cola Asíncrona (Redis + Arq)
REDIS_URL=redis://localhost:6379/0
USE_ASYNC_QUEUE=false

# Google OAuth
GOOGLE_CLIENT_ID=

UPLOADS_DIR=./uploads

# Storage Backend: LOCAL | S3
STORAGE_BACKEND=LOCAL

# Oracle Cloud (OCI) o AWS S3
S3_ENDPOINT_URL=
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRATION_SECONDS=3600

# Pipeline de Enfoque y WebP
BLUR_THRESHOLD_DEFAULT=380.0
WEBP_MAX_DIMENSION=2400
WEBP_QUALITY=82
THUMBNAIL_WIDTH=400
THUMBNAIL_QUALITY=70

# LLM Extractor
LLM_PROVIDER=AUTO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
