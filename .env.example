# =====================================================================
# Smart OCR Scanner - Variables de Entorno de Producción / Demo
# =====================================================================

# Configuración General del Servidor
PROJECT_NAME="Smart OCR Scanner API"
SECRET_KEY=super-secret-ocr-jwt-key-cambiar-en-produccion-2026

# Base de datos relacional (PostgreSQL en Docker / SQLite en desarrollo local)
POSTGRES_USER=ocr_user
POSTGRES_PASSWORD=ocr_secure_password_2026
POSTGRES_DB=ocr_scanner
DATABASE_URL=postgresql://ocr_user:ocr_secure_password_2026@postgres:5432/ocr_scanner
# DATABASE_URL=sqlite:////app/data/ocr_scanner.db

# Cola de Tareas Asíncronas (Redis + Arq)
REDIS_URL=redis://redis:6379/0
USE_ASYNC_QUEUE=true

# Autenticación con Google OAuth2 (OpenID Connect)
GOOGLE_CLIENT_ID=

# Dominio público para Caddy con HTTPS automático (Let's Encrypt)
# Ejemplos:
#   DOMAIN=:80                 -> Escucha sólo en HTTP puerto 80 (ideal para demos locales/IP directa)
#   DOMAIN=ocr.tudominio.cl    -> Genera certificado SSL TLS automático
DOMAIN=:80

# Parámetros del Pipeline de Visión Artificial y WebP
BLUR_THRESHOLD_DEFAULT=380.0
WEBP_MAX_DIMENSION=2400
WEBP_QUALITY=82

# Extractor Inteligente (LLM/VLM Opcional)
LLM_PROVIDER=AUTO
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# =====================================================================
# Configuración de Almacenamiento de Imágenes (Storage)
# =====================================================================
# Opciones para STORAGE_BACKEND:
#   - LOCAL : Guarda en el disco del servidor (volumen ./uploads_data)
#   - S3    : Almacena en la nube (compatible con AWS S3 y Oracle Cloud OCI)
STORAGE_BACKEND=LOCAL

# ---------------------------------------------------------------------
# Caso 1: Oracle Cloud Infrastructure (OCI Object Storage S3-compatible)
# ---------------------------------------------------------------------
# En OCI:
# 1. Ve a "Perfil de Usuario" -> "Customer Secret Keys" y genera Access Key y Secret Key.
# 2. Tu Endpoint es: https://{namespace}.compat.objectstorage.{region}.oraclecloud.com
#    (Ej: https://ax789bcde.compat.objectstorage.sa-santiago-1.oraclecloud.com)
# S3_ENDPOINT_URL=https://<TU_OCI_TENANCY_NAMESPACE>.compat.objectstorage.sa-santiago-1.oraclecloud.com
# S3_REGION_NAME=sa-santiago-1
# S3_BUCKET_NAME=ocr-scanner-documents
# S3_ACCESS_KEY_ID=tu_oci_access_key
# S3_SECRET_ACCESS_KEY=tu_oci_secret_key

# ---------------------------------------------------------------------
# Caso 2: Amazon Web Services (AWS S3)
# ---------------------------------------------------------------------
# En AWS: No requiere S3_ENDPOINT_URL (usa el endpoint nativo de AWS)
# S3_ENDPOINT_URL=
# S3_REGION_NAME=us-east-1
# S3_BUCKET_NAME=mi-bucket-ocr-produccion
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
